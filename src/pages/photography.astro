---
import { getCollection } from 'astro:content';
import SpotlightLayout from '../layouts/SpotlightLayout.astro';
import ProgressiveImage from '../components/ProgressiveImage.astro';

const photos = await getCollection('posts', ({ data }) => !data.draft && data.type === 'photography');
const sorted = photos.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const filters = [
  { label: 'All', value: 'all' },
  { label: 'Cafe', value: 'cafe' },
  { label: 'Street', value: 'street' },
  { label: 'Transit', value: 'transit' },
  { label: 'Harbour', value: 'harbour' },
  { label: 'Trees', value: 'trees' },
  { label: 'Film', value: 'film' },
] as const;
const years = [...new Set(sorted.map((photo) => photo.data.date.getFullYear()))].sort((a, b) => b - a);
const firstPhotoByYear = new Map<number, string>();

sorted.forEach((photo) => {
  const year = photo.data.date.getFullYear();
  if (!firstPhotoByYear.has(year)) firstPhotoByYear.set(year, photo.id);
});

function firstImage(photo: typeof sorted[number]) {
  return photo.data.gallery?.[0];
}

function cardMeta(photo: typeof sorted[number], includeCamera = false) {
  const values = [photo.data.location, String(photo.data.date.getFullYear())];
  if (includeCamera && photo.data.camera?.model) {
    values.push(photo.data.camera.model.replace('Leica Camera AG, ', '').replace('Hasselblad, ', ''));
  }
  return values.filter(Boolean).join(' · ');
}

function displayTitle(photo: typeof sorted[number]) {
  return photo.data.description || photo.data.title || firstImage(photo)?.alt || 'Photograph';
}

function cardVariant(photo: typeof sorted[number], index: number) {
  if (index === 0) return 'is-lead';

  const image = firstImage(photo);
  const width = Number(image?.width || 0);
  const height = Number(image?.height || 0);
  if (width && height && width / height < 0.82) return 'is-portrait';

  const pattern = ['is-wide', 'is-standard', 'is-standard', 'is-wide', 'is-standard', 'is-compact', 'is-standard', 'is-wide'];
  return pattern[(index - 1) % pattern.length];
}

function filterGroups(photo: typeof sorted[number]) {
  const haystack = [
    photo.data.title,
    photo.data.description,
    photo.data.location,
    photo.data.camera?.model,
    photo.data.camera?.lens,
    ...(photo.data.tags ?? []),
    ...(photo.data.gallery ?? []).flatMap((image) => [image.alt, image.caption]),
  ].filter(Boolean).join(' ').toLowerCase();

  const groups = new Set<string>(['all']);
  if (haystack.includes('cafe') || haystack.includes('coffee') || haystack.includes('bakery') || haystack.includes('咖啡')) groups.add('cafe');
  if (haystack.includes('street') || haystack.includes('road') || haystack.includes('taxi') || haystack.includes('motorcycle') || haystack.includes('cyclist') || haystack.includes('街')) groups.add('street');
  if (haystack.includes('train') || haystack.includes('taxi') || haystack.includes('road') || haystack.includes('车厢') || haystack.includes('出租车')) groups.add('transit');
  if (haystack.includes('harbour') || haystack.includes('skyline') || haystack.includes('boat') || haystack.includes('海') || haystack.includes('港')) groups.add('harbour');
  if (haystack.includes('tree') || haystack.includes('canopy') || haystack.includes('flowers') || haystack.includes('树') || haystack.includes('花')) groups.add('trees');
  if (haystack.includes('noritsu') || haystack.includes('film') || haystack.includes('胶片')) groups.add('film');

  return [...groups].join(' ');
}
---

<SpotlightLayout title="Photographs | Joey's Notes" description="Personal photographs from cafes, streets, transit windows, trees, and quiet daily light." lang="zh">
  <section class="photo-index-page" id="archive">
    <div class="photo-shell shell">
      <header class="photo-index-head">
        <div class="photo-index-title">
          <h1>Photographs</h1>
        </div>
        <nav class="filter-index" aria-label="摄影筛选索引">
          {filters.map((filter, index) => (
            <a
              href={index === 0 ? '/photography/' : `/photography/?tag=${filter.value}`}
              aria-current={index === 0 ? 'page' : undefined}
              data-photo-filter={filter.value}
            >
              {filter.label}
            </a>
          ))}
        </nav>
      </header>

      <div class="photo-browser">
        <nav class="year-index" aria-label="按年份浏览摄影作品">
          {years.map((year, index) => (
            <a
              href={`#year-${year}`}
              aria-current={index === 0 ? 'location' : undefined}
              data-photo-year-link={year}
            >
              {year}
            </a>
          ))}
        </nav>

        <div class="contact-sheet" aria-live="polite">
          {sorted.map((photo, index) => {
            const image = firstImage(photo);
            if (!image) return null;
            const year = photo.data.date.getFullYear();
            const isYearStart = firstPhotoByYear.get(year) === photo.id;
            const title = displayTitle(photo);
            const ratio = image.width && image.height ? `${image.width} / ${image.height}` : '3 / 2';
            return (
              <article
                class={`contact-card ${cardVariant(photo, index)}`}
                id={isYearStart ? `year-${year}` : undefined}
                data-photo-year={year}
                data-photo-filter-groups={filterGroups(photo)}
                style={`--photo-ratio: ${ratio};`}
              >
                <a
                  href={`/posts/${photo.id}/`}
                  class="contact-card__media"
                  aria-label={title}
                  data-astro-prefetch
                >
                  <ProgressiveImage
                    src={image.src}
                    alt={image.alt || title}
                    class="contact-card__image"
                    loading={index === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                    fetchpriority={index === 0 ? 'high' : 'low'}
                    width={image.width}
                    height={image.height}
                    sizes={index === 0 ? '(min-width: 960px) 30vw, 100vw' : '(min-width: 960px) 24vw, 50vw'}
                    style={`view-transition-name: photo-cover-${photo.id};`}
                  />
                  {index !== 0 && <span class="contact-card__hover-label">{photo.data.title || title}</span>}
                </a>
                {index === 0 && (
                  <div class="contact-card__caption">
                    <h2><a href={`/posts/${photo.id}/`} data-astro-prefetch style={`view-transition-name: photo-title-${photo.id};`}>{title}</a></h2>
                    <p>{cardMeta(photo, true)}</p>
                  </div>
                )}
              </article>
            );
          })}
          <p class="contact-sheet__empty" data-photo-empty hidden>没有符合当前筛选的摄影作品。</p>
        </div>
      </div>
    </div>
  </section>
</SpotlightLayout>

<style>
  .photo-index-page {
    margin-top: 0;
    min-height: 100vh;
    padding-block: clamp(1.75rem, 3vw, 2.8rem) clamp(4rem, 8vw, 7rem);
    background: #11100e;
    color: #eee7dc;
  }

  .photo-shell {
    width: min(100%, 92rem);
  }

  .photo-shell :is(h1, h2, a) {
    color: #eee7dc;
  }

  .photo-shell p {
    color: #aaa197;
  }

  .photo-index-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(1.4rem, 2vw, 1.7rem);
  }

  .photo-index-title {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
  }

  .photo-index-title h1 {
    margin: 0;
    font-size: clamp(2.25rem, 3.2vw, 2.65rem);
    line-height: 1;
    font-weight: 600;
  }

  .filter-index {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    max-width: 100%;
    justify-content: flex-end;
  }

  .filter-index a {
    display: inline-flex;
    min-height: 2.35rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(238, 231, 220, 0.13);
    border-radius: 999px;
    padding: 0.4rem 0.84rem;
    color: #aaa197;
    background: transparent;
    font-size: 0.88rem;
    line-height: 1;
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard),
      background var(--duration-fast) var(--ease-standard);
  }

  .filter-index a:hover,
  .filter-index a:focus-visible,
  .filter-index a[aria-current='page'] {
    border-color: rgba(208, 138, 114, 0.76);
    color: #eee7dc;
    background: rgba(208, 138, 114, 0.045);
  }

  .filter-index a:focus-visible {
    outline: 2px solid rgba(238, 231, 220, 0.34);
    outline-offset: 3px;
  }

  .contact-card[hidden],
  .year-index a[hidden] {
    display: none;
  }

  .photo-browser {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: clamp(1rem, 2vw, 1.6rem);
    align-items: start;
  }

  .year-index {
    position: sticky;
    top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    border-left: 1px solid #34302b;
    padding-block: 0.15rem;
  }

  .year-index a {
    display: flex;
    min-height: 1.8rem;
    align-items: center;
    border-left: 2px solid transparent;
    margin-left: -1px;
    padding-left: 0.75rem;
    color: #8e867e;
    font-size: 0.84rem;
    line-height: 1;
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .year-index a:hover,
  .year-index a:focus-visible,
  .year-index a[aria-current='location'] {
    border-left-color: #b86f55;
    color: #d08a72;
  }

  .contact-sheet {
    display: grid;
    grid-template-columns: repeat(15, minmax(0, 1fr));
    grid-auto-flow: dense;
    grid-auto-rows: clamp(3.5rem, 4.5vw, 4.1rem);
    gap: clamp(0.55rem, 0.9vw, 0.78rem);
    min-width: 0;
  }

  .contact-card {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background: #191816;
    content-visibility: auto;
    contain-intrinsic-size: auto 18rem;
    scroll-margin-top: 1rem;
  }

  .contact-card.is-lead {
    grid-column: span 5;
    grid-row: span 7;
    flex-direction: column;
    border: 1px solid rgba(184, 111, 85, 0.9);
  }

  .contact-card.is-wide {
    grid-column: span 4;
    grid-row: span 3;
  }

  .contact-card.is-standard {
    grid-column: span 3;
    grid-row: span 3;
  }

  .contact-card.is-compact {
    grid-column: span 2;
    grid-row: span 3;
  }

  .contact-card.is-portrait {
    grid-column: span 3;
    grid-row: span 4;
  }

  .contact-card__media {
    position: relative;
    display: block;
    width: 100%;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background: #191816;
  }

  .contact-card:not(.is-lead) .contact-card__media,
  .contact-card.is-lead .contact-card__media {
    flex: 1 1 auto;
  }

  .contact-card__media :global(.progressive-image) {
    width: 100%;
    height: 100%;
  }

  .contact-card__image {
    transition:
      transform var(--duration-slow) var(--ease-standard),
      opacity var(--duration-base) var(--ease-standard);
  }

  .contact-card__caption {
    flex: 0 0 auto;
    border-top: 1px solid rgba(184, 111, 85, 0.48);
    padding: 0.65rem 0.85rem 0.72rem;
    background: #151311;
  }

  .contact-card__caption h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(0.84rem, 1.15vw, 1rem);
    font-weight: 500;
    line-height: 1.4;
  }

  .contact-card__caption h2 a {
    text-decoration: none;
  }

  .contact-card__caption p {
    margin: 0.18rem 0 0;
    font-size: 0.74rem;
    line-height: 1.35;
  }

  .contact-card__hover-label {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    overflow: hidden;
    padding: 0.55rem 0.65rem;
    color: #eee7dc;
    background: rgba(17, 16, 14, 0.88);
    font-size: 0.74rem;
    line-height: 1.3;
    opacity: 0;
    text-overflow: ellipsis;
    white-space: nowrap;
    transform: translateY(0.35rem);
    transition:
      opacity var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  .contact-card__media:hover .contact-card__hover-label,
  .contact-card__media:focus-visible .contact-card__hover-label {
    opacity: 1;
    transform: translateY(0);
  }

  .contact-sheet__empty {
    grid-column: 1 / -1;
    margin: 2rem 0;
    font-size: 0.92rem;
  }

  @media (min-width: 641px) {
    .photo-index-title {
      margin-left: calc(3.5rem + clamp(1rem, 2vw, 1.6rem));
    }
  }

  @media (max-width: 960px) {
    .photo-index-head {
      align-items: start;
      flex-direction: column;
      gap: 1.1rem;
    }

    .filter-index {
      justify-content: flex-start;
    }

    .contact-sheet {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      grid-auto-rows: 4.2rem;
    }

    .contact-card.is-lead {
      grid-column: span 4;
    }

    .contact-card.is-wide,
    .contact-card.is-standard,
    .contact-card.is-portrait {
      grid-column: span 4;
    }

    .contact-card.is-compact {
      grid-column: span 2;
    }
  }

  @media (max-width: 640px) {
    .photo-index-page {
      padding-top: 1.3rem;
    }

    .filter-index {
      flex-wrap: nowrap;
      justify-content: flex-start;
      width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .filter-index::-webkit-scrollbar {
      display: none;
    }

    .filter-index a {
      flex: 0 0 auto;
      min-height: 2.75rem;
      padding-inline: 0.9rem;
    }

    .photo-index-title h1 {
      font-size: 2.35rem;
    }

    .photo-browser {
      display: block;
    }

    .year-index {
      position: sticky;
      top: 0;
      z-index: 6;
      flex-direction: row;
      gap: 0;
      width: 100%;
      margin-inline: -0.5rem;
      margin-bottom: 1rem;
      padding-inline: 0.5rem;
      overflow-x: auto;
      border: 0;
      background: rgba(17, 16, 14, 0.94);
      backdrop-filter: blur(12px);
      scrollbar-width: none;
    }

    .year-index::-webkit-scrollbar {
      display: none;
    }

    .year-index a {
      flex: 0 0 auto;
      min-height: 2.75rem;
      border-left: 0;
      border-bottom: 2px solid transparent;
      margin: 0;
      padding-inline: 0.85rem;
    }

    .year-index a:hover,
    .year-index a:focus-visible,
    .year-index a[aria-current='location'] {
      border-left-color: transparent;
      border-bottom-color: #b86f55;
    }

    .contact-sheet {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-flow: row;
      grid-auto-rows: auto;
      gap: 0.72rem;
    }

    .contact-card,
    .contact-card.is-wide,
    .contact-card.is-standard,
    .contact-card.is-compact,
    .contact-card.is-portrait {
      grid-column: span 1;
      grid-row: auto;
      display: block;
      overflow: visible;
      background: transparent;
    }

    .contact-card.is-lead {
      grid-column: 1 / -1;
      grid-row: auto;
      display: flex;
      overflow: hidden;
    }

    .contact-card:not(.is-lead) .contact-card__media {
      aspect-ratio: var(--photo-ratio);
      max-height: 22rem;
    }

    .contact-card.is-lead .contact-card__media {
      aspect-ratio: var(--photo-ratio);
      max-height: none;
    }
  }

  @media (hover: hover) {
    .contact-card:hover .contact-card__image,
    .contact-card:focus-within .contact-card__image {
      transform: scale(1.018);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-card__image,
    .contact-card__hover-label {
      transition: none;
    }
  }
</style>

<script is:inline data-astro-rerun>
  (() => {
    const root = document.querySelector('.photo-index-page');
    if (!root || root.dataset.photoFiltersBound === 'true') return;

    const links = Array.from(root.querySelectorAll('[data-photo-filter]'));
    const items = Array.from(root.querySelectorAll('[data-photo-filter-groups]'));
    const yearLinks = Array.from(root.querySelectorAll('[data-photo-year-link]'));
    const yearIndex = root.querySelector('.year-index');
    const emptyState = root.querySelector('[data-photo-empty]');
    if (!links.length || !items.length) return;

    root.dataset.photoFiltersBound = 'true';
    const controller = new AbortController();
    const filters = new Set(links.map((link) => link.getAttribute('data-photo-filter')).filter(Boolean));
    let yearScrollFrame = 0;

    function getFilterFromUrl() {
      const tag = new URL(window.location.href).searchParams.get('tag') || 'all';
      return filters.has(tag) ? tag : 'all';
    }

    function updateUrl(filter) {
      const url = new URL(window.location.href);
      if (filter === 'all') {
        url.searchParams.delete('tag');
      } else {
        url.searchParams.set('tag', filter);
      }
      url.hash = '';
      history.pushState({ photoFilter: filter }, '', url);
    }

    function setActiveYear(year, reveal = true) {
      if (!year) return;

      const activeLink = yearLinks.find((link) => !link.hidden && link.getAttribute('data-photo-year-link') === year);
      if (!activeLink) return;

      const changed = activeLink.getAttribute('aria-current') !== 'location';
      yearLinks.forEach((link) => link.removeAttribute('aria-current'));
      activeLink.setAttribute('aria-current', 'location');

      if (changed && reveal && yearIndex && yearIndex.scrollWidth > yearIndex.clientWidth) {
        const left = activeLink.offsetLeft - (yearIndex.clientWidth - activeLink.clientWidth) / 2;
        yearIndex.scrollTo({
          left: Math.max(0, left),
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        });
      }
    }

    function syncActiveYear(reveal = true) {
      const firstVisibleLink = yearLinks.find((link) => !link.hidden);
      const threshold = Math.max(24, Math.min(window.innerHeight * 0.16, 144));
      const activeItem = items.find((item) => !item.hidden && item.getBoundingClientRect().bottom > threshold);
      const year = activeItem?.getAttribute('data-photo-year') || firstVisibleLink?.getAttribute('data-photo-year-link');
      setActiveYear(year, reveal);
    }

    function scheduleYearSync() {
      if (yearScrollFrame) return;
      yearScrollFrame = window.requestAnimationFrame(() => {
        yearScrollFrame = 0;
        syncActiveYear();
      });
    }

    function applyFilter(filter) {
      let visibleCount = 0;
      items.forEach((item) => {
        const groups = (item.getAttribute('data-photo-filter-groups') || '').split(/\s+/);
        const hidden = filter !== 'all' && !groups.includes(filter);
        item.hidden = hidden;
        if (!hidden) visibleCount += 1;
      });

      links.forEach((link) => {
        const active = link.getAttribute('data-photo-filter') === filter;
        if (active) {
          link.setAttribute('aria-current', 'page');
        } else {
          link.removeAttribute('aria-current');
        }
      });

      yearLinks.forEach((link) => {
        const year = link.getAttribute('data-photo-year-link');
        link.hidden = !items.some((item) => !item.hidden && item.getAttribute('data-photo-year') === year);
      });

      if (emptyState) emptyState.hidden = visibleCount !== 0;
      window.requestAnimationFrame(() => syncActiveYear(false));
    }

    links.forEach((link) => {
      link.addEventListener('click', (event) => {
        const filter = link.getAttribute('data-photo-filter') || 'all';
        event.preventDefault();
        applyFilter(filter);
        updateUrl(filter);
      }, { signal: controller.signal });
    });

    yearLinks.forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        const year = link.getAttribute('data-photo-year-link');
        const target = items.find((item) => !item.hidden && item.getAttribute('data-photo-year') === year);
        if (!target) return;

        setActiveYear(year);
        target.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });

        const url = new URL(window.location.href);
        url.hash = `year-${year}`;
        history.pushState({ photoYear: year }, '', url);
      }, { signal: controller.signal });
    });

    window.addEventListener('scroll', scheduleYearSync, { passive: true, signal: controller.signal });
    window.addEventListener('resize', scheduleYearSync, { passive: true, signal: controller.signal });
    window.addEventListener('popstate', () => applyFilter(getFilterFromUrl()), { signal: controller.signal });
    document.addEventListener('astro:before-swap', () => {
      if (yearScrollFrame) window.cancelAnimationFrame(yearScrollFrame);
      controller.abort();
    }, { once: true, signal: controller.signal });
    applyFilter(getFilterFromUrl());
  })();
</script>
